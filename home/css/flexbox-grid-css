body {
  font-family: 'Arial', sans-serif;
  line-height: 1.6;
  margin: 0;
  padding: 0;
  background: #f9f9f9;
  color: #333;
}

h1 {
  text-align: center;
  margin: 20px 0;
  color: #37474f;
}

.flex-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  margin: 20px;
  gap: 20px;
}

.flex-container > div {
  background: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 20px;
  flex: 1 1 calc(30% - 40px);
  max-width: calc(30% - 40px);
  box-sizing: border-box;
}

h2 {
  font-size: 1.5em;
  color: #1e88e5;
  margin-bottom: 10px;
  text-align: center;
}

p, ul {
  font-size: 1em;
  line-height: 1.5;
  text-align: justify;
}

ul {
  padding-left: 20px;
}

li {
  margin: 5px 0;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}

table {
  margin: 0 auto;
  border-collapse: collapse;
}

td {
  padding: 10px;
}

@media (max-width: 768px) {
  .flex-container > div {
      flex: 1 1 calc(100% - 40px);
      max-width: calc(100% - 40px);
  }

  h1 {
      font-size: 1.8em;
  }

  h2 {
      font-size: 1.3em;
  }
}
