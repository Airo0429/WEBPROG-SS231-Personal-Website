.container {
  display: grid;
  grid-template-rows: auto 1fr auto;
  height: 100vh;
  font-family: 'Arial', sans-serif;
  background: linear-gradient(to bottom, #e3f2fd, #fff);
}

header, footer {
  background-color: #37474f;
  color: #fff;
  padding: 20px;
  text-align: center;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 24px;
}

main {
  display: flex;
  flex-direction: row;
  gap: 20px;
  padding: 20px;
}

.main-content {
  flex: 3;
  background: #fff;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.main-content > div {
  background: linear-gradient(to bottom right, #90caf9, #1e88e5);
  border-radius: 8px;
  color: #fff;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 20px;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 1.5;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.main-content > div:hover {
  transform: translateY(-10px);
  box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15);
}

.sidebar {
  flex: 1;
  background: linear-gradient(to bottom, #f1f8e9, #c8e6c9);
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  text-align: center;
}

.sidebar h2 {
  font-size: 20px;
  margin-bottom: 20px;
  color: #388e3c;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar ul li {
  margin: 10px 0;
  padding: 10px;
  background-color: #a5d6a7;
  border-radius: 4px;
  color: #2e7d32;
  font-weight: bold;
  transition: background-color 0.3s ease;
}

.sidebar ul li:hover {
  background-color: #66bb6a;
  cursor: pointer;
}

footer {
  font-size: 16px;
  letter-spacing: 1px;
  background-color: #263238;
}
